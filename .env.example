LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=priya
# Exact browser origins allowed to call the APIs: comma-separated, no trailing slash.
# Production: https://optimizerstep.com,https://www.optimizerstep.com
VOICE_ALLOWED_ORIGIN=http://localhost:8000

# Text chat: at most 4 attempts per IP and 40 across the site per UTC day.
CHAT_VISITOR_DAILY_LIMIT=4
CHAT_SITE_DAILY_LIMIT=40

# Website enquiries database: its own PostgreSQL database and user, never the voice-agent appointment DB.
# Append ?sslmode=require when connecting over the public internet.
DATABASE_URL=

# Contact form: every enquiry is saved to PostgreSQL first. Fill these to also email it to your team.
# Gmail needs an App Password (requires 2-Step Verification), not your normal password.
ENQUIRY_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OpenAI powers text chat only; Sarvam continues to power voice.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
